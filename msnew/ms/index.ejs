            <a href="/" class="flex items-center gap-2">
                <img src="/images/logo.png" alt="Logo" class="h-9 w-auto object-contain hover:scale-105 transition">
                <span class="bm-heading text-sm font-bold hidden sm:inline">Membership VIP</span>
            </a>
            
            <!-- 2. BAGIAN MENU NAVIGASI KANAN -->
            <nav class="flex items-center space-x-2 md:space-x-4 text-sm font-semibold">
                <a href="/" class="text-[var(--text-secondary)] hover:text-[var(--accent-blue)] transition flex items-center gap-1.5 px-3 py-1.5 rounded-xl hover:bg-[var(--card-inner)]">
                    <span>Membership</span>
                </a>
                <a href="/faq" class="text-[var(--text-secondary)] hover:text-[var(--accent-blue)] transition flex items-center gap-1.5 px-3 py-1.5 rounded-xl hover:bg-[var(--card-inner)]">
                    <i class="fa-solid fa-circle-question text-[var(--accent-blue)]"></i>
                    <span>FAQ</span>
                </a>
                <a href="/contact" class="text-[var(--text-secondary)] hover:text-[var(--accent-blue)] transition flex items-center gap-1.5 px-3 py-1.5 rounded-xl hover:bg-[var(--card-inner)]">
                    <i class="fa-solid fa-headset text-[var(--accent-blue)]"></i>
                    <span>Contact</span>
                </a>
                <a href="#pricing-section" class="bg-gradient-to-r from-blue-600 to-cyan-500 text-white font-bold px-4 py-2 rounded-xl shadow-md transition hover:opacity-90">
                    Harga
                </a>

                <!-- TOMBOL KELUAR / KEMBALI KE WEB UTAMA (LOGIN) -->
                <a href="https://membahassahamindonesia.com" class="text-rose-500 hover:bg-rose-500/10 px-3 py-1.5 rounded-xl transition text-xs font-bold border border-rose-500/20">
                    <i class="fa-solid fa-right-from-bracket"></i> Keluar
                </a>

                <!-- TOGGLE LIGHT / DARK MODE -->
                <button id="themeToggleBtn" onclick="toggleTheme()" class="bg-[var(--card-bg)] border border-[var(--card-border)] text-[var(--text-primary)] hover:border-[var(--accent-blue)] px-3 py-2 rounded-xl text-xs flex items-center gap-2 transition ml-2 shadow-sm">
                    <i id="themeIcon" class="fa-solid fa-sun text-amber-500"></i>
                    <span id="themeText" class="hidden sm:inline font-bold">Light</span>
                </button>
            </nav>
        </div>
    </header>

