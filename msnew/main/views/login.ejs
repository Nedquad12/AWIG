<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/jpeg" href="/images/logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="antialiased min-h-screen flex items-center justify-center p-4">

    <div class="max-w-md w-full bm-card p-8 shadow-xl">
        <div class="text-center mb-6">
            <img src="/images/logo.png" alt="Logo" class="h-10 mx-auto mb-3 object-contain">
            <h1 class="text-2xl bm-heading">Masuk ke Akun Anda</h1>
            <p class="text-xs text-[var(--text-secondary)] mt-1">PT Membahas Saham Indonesia</p>
        </div>

        <!-- Tombol Google Login -->
        <button onclick="alert('Fitur Google OAuth akan segera diaktifkan')" class="w-full bg-[var(--card-inner)] border border-[var(--card-border)] hover:border-[var(--accent-blue)] py-3 px-4 rounded-xl font-semibold text-sm flex items-center justify-center gap-3 transition mb-4">
            <i class="fa-brands fa-google text-rose-500 text-base"></i> Masuk dengan Google
        </button>

        <div class="flex items-center my-4">
            <div class="flex-grow border-t border-[var(--card-border)]"></div>
            <span class="px-3 text-xs text-[var(--text-secondary)]">Atau dengan Email</span>
            <div class="flex-grow border-t border-[var(--card-border)]"></div>
        </div>

        <form action="/auth/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">Email</label>
                <input type="email" name="email" required placeholder="nama@email.com"
                    class="w-full bg-[var(--card-inner)] border border-[var(--card-border)] rounded-xl px-4 py-3 text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-blue)] transition">
            </div>
            <div>
                <label class="block text-xs font-semibold text-[var(--text-secondary)] mb-1">Password</label>
                <input type="password" name="password" required placeholder="••••••••"
                    class="w-full bg-[var(--card-inner)] border border-[var(--card-border)] rounded-xl px-4 py-3 text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-blue)] transition">
            </div>
            <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-cyan-500 text-white font-bold py-3 rounded-xl shadow-md transition hover:opacity-90">
                Masuk
            </button>
        </form>

        <p class="text-center text-xs text-[var(--text-secondary)] mt-6">
            Belum punya akun? <a href="https://vip.membahassahamindonesia.com/#pricing-section" class="text-[var(--accent-blue)] font-bold hover:underline">Daftar / Pilih Paket VIP</a>
        </p>
    </div>

</body>
</html>